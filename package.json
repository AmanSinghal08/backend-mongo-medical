{
  "name": "coindesi",
  "version": "1.0.0",
  "scripts": {
    "copy-files": "copyfiles -u 1 \"src/**/*.{html,ejs}\" dist/",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "build": "npm run clean && tsc && npm run copy-files",
    "dev": "dotenv -e .env.development -- ts-node-dev --respawn --transpile-only src/server.ts",
    "start:staging": "dotenv -e .env.staging -- node dist/server.js",
    "start:prod": "dotenv -e .env.production -- node dist/server.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "compression": "^1.7.5",
    "copyfiles": "^2.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "dotenv-cli": "^7.3.0",
    "express": "^5.0.0",
    "helmet": "^7.1.0",
    "http-errors": "^2.0.0",
    "joi": "^17.12.0",
    "lodash": "^4.17.23",
    "mongoose": "^8.23.0",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.0",
    "rimraf": "^5.0.5",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/lodash": "^4.17.23",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.0",
 
    "dotenv-cli": "^7.3.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.0"
  }
}
